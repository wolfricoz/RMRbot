# Copy to .env and fill in the values.

# Discord
DISCORD_TOKEN=""
PREFIX="!"

# Database server url without the database name: the bot appends /rmrbotnew.
# MySQL/MariaDB: "mysql://user:password@localhost:3306"   PostgreSQL: "postgresql://user:password@localhost:5432"
DB=""

# Channel id of the dev room, where the bot posts its startup and log messages.
DEV=""
# Channel id of the old lobby, read daily to update the ban list.
OLDLOBBY=""
VERSION=""
# Fernet key for encrypting stored data (classes/encryption.py).
KEY=""

# FastAPI app: with API="TRUE" the bot is started by uvicorn (uvicorn main:app) instead of bot.run.
API="FALSE"
# Token API requests must send in the X-Auth-Token header.
API_KEY=""

# Website (roleplaymeets.com) API for cross-posting adverts: base url without a trailing slash, and a Sanctum token.
WEBSITE_URL="https://roleplaymeets.com"
WEBSITE_KEY=""
